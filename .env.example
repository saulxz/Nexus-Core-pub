# ============================================================
#  Nexus-Core — Plantilla de variables de entorno
#  Copia este fichero a `.env` y ajusta los valores:
#      cp .env.example .env
#  NO subas nunca el `.env` real al repositorio (está en .gitignore).
# ============================================================

# ----------------------- Aplicación -----------------------
APP_NAME=Nexus-Core
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO
FRONTEND_DIR=frontend
# Orígenes permitidos por CORS (csv). Vacío = sin CORS (same-origin), el modo
# recomendado: el panel y la API se sirven desde el mismo host.
ALLOWED_ORIGINS=

# ----------------------- Seguridad ------------------------
# Hosts aceptados por TrustedHostMiddleware (csv). "*" = cualquiera (LAN).
# Con el tunel fijo de Cloudflare, limita al dominio publico:
ALLOWED_HOSTS=nexus.example.com,localhost,127.0.0.1
# Sesiones del panel: caducidad por inactividad y absoluta.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Poner a true cuando el panel se sirva por HTTPS (nexus.example.com).
# En LAN por HTTP (http://127.0.0.1:8780) debe ser false o no habra sesion.
SESSION_COOKIE_SECURE=true
# Intentos de login por usuario+IP dentro de la ventana (segundos).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900

# ------------------------- Docker -------------------------
DOCKER_SOCKET=unix:///var/run/docker.sock
CONTAINER_NAME_PREFIX=nexus-
MAX_RUNNING_CONTAINERS=15
# Whitelist de imágenes que el usuario/IA puede desplegar (csv).
ALLOWED_IMAGES=alpine,nginx,httpd,busybox,redis,postgres,mysql,traefik,portainer

# -------------------------- Red ---------------------------
# Subred por defecto para el escaneo de hosts activos (CIDR RFC1918).
SCAN_DEFAULT_SUBNET=192.168.1.0/24
SCAN_TIMEOUT_SECONDS=120

# ------------- Monitores y exportación a Prometheus -------------
# Comprobador de monitores de disponibilidad (http/tcp/ssl) en segundo plano.
# Ponlo a false en los tests o durante un mantenimiento sin tráfico saliente.
MONITORS_ENABLED=true
# Token de /api/metrics/prometheus. Vacío = endpoint público (por defecto).
# Con token, Prometheus debe raspar con «Authorization: Bearer <token>».
METRICS_TOKEN=

# ------------------- Flota de hosts (agentes remotos) -----------------
# Token de enrolamiento: lo presentan los agentes en POST /api/agent/enroll
# para darse de alta. Vacío = el hub genera uno persistente y lo muestra en
# GET /api/hosts/enrollment (solo administrador). Quien lo tenga puede dar de
# alta un host en el panel: trátalo como un secreto y rótalo si se filtra.
AGENT_ENROLL_TOKEN=
# Segundos sin latido a partir de los cuales un host se marca «offline».
AGENT_ONLINE_WINDOW=30

# ---------------------- Terminal SSH del panel ----------------------
# Destino de la pestaña Terminal. Vacío en TERMINAL_SSH_USER = desactivada.
TERMINAL_SSH_HOST=127.0.0.1
TERMINAL_SSH_PORT=22
TERMINAL_SSH_USER=
TERMINAL_SSH_KEY=/etc/nexus/terminal_key
TERMINAL_SSH_KNOWN_HOSTS=/etc/nexus/terminal_known_hosts
TERMINAL_IDLE_SECONDS=900
# Destinos remotos del desplegable. Clave = id/nombre/hostname del inventario.
# El host local usa TERMINAL_SSH_*; aquí solo van los remotos con SSH accesible.
# TERMINAL_TARGETS={"ubuntu-server-sor":{"host":"192.168.1.10","port":22,"user":"saul_server"}}

# --------------------- Agente de IA -----------------------
# Proveedor: openai | anthropic | gemini | ollama
# Vacío = sin proveedor: el asistente queda desactivado (es opcional y el
# resto del panel funciona igual).
AI_PROVIDER=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOOL_ITERATIONS=4
# --- OpenAI (o cualquier API compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# --- Google Gemini (API Generative Language) ---
# La clave se envía en la cabecera x-goog-api-key.
# Si AI_PROVIDER=gemini y AI_MODEL no empieza por "gemini", se usa GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
# --- Ollama local en el host de la Raspberry Pi (endpoint compatible OpenAI) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Ejemplo de uso con Gemini:
#   AI_PROVIDER=gemini
#   AI_MODEL=gemini-2.5-flash
#   GEMINI_API_KEY=tu_clave_de_google_ai_studio
# Ejemplo de uso con Ollama (IA 100% local, sin nube):
#   AI_PROVIDER=ollama
#   AI_MODEL=llama3.2:3b
#   OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Terminal local del hub (PowerShell sobre PTY; solo Windows).
# TERMINAL_LOCAL_SHELL=true
# TERMINAL_LOCAL_SHELL_COMMAND=powershell.exe -NoLogo -NoProfile
