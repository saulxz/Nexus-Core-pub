# ============================================================
#  Nexus-Core — Plantilla de variables de entorno
#  Copia este fichero a `.env` y ajusta los valores:
#      cp .env.example .env
#  NO subas nunca el `.env` real al repositorio (está en .gitignore).
# ============================================================

# ----------------------- Aplicación -----------------------
APP_NAME=Nexus-Core
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO
FRONTEND_DIR=frontend
# Orígenes permitidos por CORS (csv). En producción restringe el dominio.
ALLOWED_ORIGINS=*

# ------------------------- Docker -------------------------
DOCKER_SOCKET=unix:///var/run/docker.sock
CONTAINER_NAME_PREFIX=nexus-
MAX_RUNNING_CONTAINERS=15
# Whitelist de imágenes que el usuario/IA puede desplegar (csv).
ALLOWED_IMAGES=alpine,nginx,httpd,busybox,redis,postgres,mysql,traefik,portainer

# -------------------------- Red ---------------------------
# Subred por defecto para el escaneo de hosts activos (CIDR RFC1918).
SCAN_DEFAULT_SUBNET=192.168.1.0/24
SCAN_TIMEOUT_SECONDS=120

# --------------------- Agente de IA -----------------------
# Proveedor: openai | anthropic | gemini | ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
AI_MAX_TOOL_ITERATIONS=4
# --- OpenAI (o cualquier API compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# --- Google Gemini (API Generative Language) ---
# La clave se envía en la cabecera x-goog-api-key.
# Si AI_PROVIDER=gemini y AI_MODEL no empieza por "gemini", se usa GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
# --- Ollama local en el host de la Raspberry Pi (endpoint compatible OpenAI) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Ejemplo de uso con Gemini:
#   AI_PROVIDER=gemini
#   AI_MODEL=gemini-2.5-flash
#   GEMINI_API_KEY=tu_clave_de_google_ai_studio
# Ejemplo de uso con Ollama (IA 100% local, sin nube):
#   AI_PROVIDER=ollama
#   AI_MODEL=llama3.2:3b
#   OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
