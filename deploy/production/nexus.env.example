# ============================================================
#  Nexus-Core — entorno de producción
#  Instalar como /etc/nexus/nexus.env con permisos 0600:
#     sudo install -m 0600 -o root -g root nexus.env /etc/nexus/nexus.env
#  La unidad systemd lo carga con EnvironmentFile y tiene prioridad
#  sobre los valores por defecto del servicio.
# ============================================================

# Solo Caddy debe ser accesible desde Internet; uvicorn escucha en local.
NEXUS_BIND_HOST=127.0.0.1
NEXUS_BIND_PORT=8000

# Datos persistentes (BD, token de enrolamiento, auditoría).
NEXUS_DATA_DIR=/var/lib/nexus
FRONTEND_DIR=frontend

# HTTPS obligatorio: sin esto la cookie de sesión no se marca Secure.
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Redirige a HTTPS si Cloudflare indica que el cliente llegó por HTTP.
ENFORCE_HTTPS=true

# Dominio real del panel (sin esquema). Añade www si lo usas.
ALLOWED_HOSTS=nexus.labsxz.com

# Clave maestra para cifrar TOTP en reposo. Debe quedar fuera de NEXUS_DATA_DIR
# y no incluirse en backups. install.sh la genera con permisos 0600.
NEXUS_SECRET_KEY_FILE=/etc/nexus/secret.key

# Orígenes CORS: vacío = same-origin (recomendado).
ALLOWED_ORIGINS=

# Secreto de enrolamiento de agentes. Genera uno con:
#   openssl rand -hex 32
# Cambiarlo y reiniciar invalida el token anterior para nuevos agentes;
# los tokens ya emitidos a hosts existentes siguen valiendo.
AGENT_ENROLL_TOKEN=cambia-esto-por-openssl-rand-hex-32
