[Unit]
Description=Nexus-Core — copia de seguridad de la base de datos y la configuración
Documentation=file:/opt/nexus-core/deploy/PRODUCCION.md
After=nexus.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/nexus-core/deploy/production/backup-nexus.py --data-dir /var/lib/nexus --out /var/backups/nexus --keep 14
