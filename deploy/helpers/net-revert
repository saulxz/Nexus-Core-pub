#!/usr/bin/env bash
# ============================================================
#  net-revert — revierte un cambio de red no confirmado.
#
#  Uso:  net-revert <token-hex12>
#
#  Lo invoca automáticamente el watchdog de systemd (net-apply) cuando el
#  administrador no confirma a tiempo. Restaura la última copia del drop-in
#  (o lo retira si no había) y reaplica la red.
#
#  Propiedad de root; solo autorizado vía /etc/sudoers.d/nexus.
# ============================================================
set -euo pipefail

BACKUP_DIR="/var/backups/nexus/netplan"
TARGET="/etc/netplan/90-nexus.yaml"

TOKEN="${1:-}"
[[ "$TOKEN" =~ ^[a-f0-9]{12}$ ]] || { echo "token no válido" >&2; exit 64; }

LATEST="$(ls -1t "$BACKUP_DIR"/90-nexus.yaml.* 2>/dev/null | head -n 1 || true)"
if [[ -n "$LATEST" && -f "$LATEST" ]]; then
  cp -a "$LATEST" "$TARGET"
  RESTORED="desde $LATEST"
else
  rm -f "$TARGET"
  RESTORED="sin copia previa (drop-in retirado)"
fi

/usr/sbin/netplan generate
/usr/sbin/netplan apply

logger -t nexus-netguard "cambio de red $TOKEN revertido automáticamente (sin confirmación; $RESTORED)"
echo "REVERTIDO: cambio $TOKEN deshecho ($RESTORED)"
